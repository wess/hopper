#!/bin/sh
# Hopper guest port-forwarding agent.
#
# socat runs one instance per connection on vsock:2378 (see init). The host
# writes a single "host:port" line naming a target inside the guest, then the
# rest of the connection is spliced straight through to it.
#
# This is what makes `docker run -p 8080:80` reachable at localhost:8080 on the
# Mac: the host opens a listener per published port and pipes each accepted
# connection here.
#
# Kept tiny and dependency-free (busybox sh + socat), like /agent.

read -r target

# Only "host:port" is acceptable. Anything else is refused rather than passed
# to socat, so a malformed line cannot turn into an arbitrary exec.
case "$target" in
  *[!0-9a-zA-Z.:_-]* | '' | *' '*)
    exit 1
    ;;
esac

host=${target%:*}
port=${target##*:}

# The port must be a number in range; a non-numeric one would otherwise reach
# socat as part of its address string.
case "$port" in
  '' | *[!0-9]*) exit 1 ;;
esac
[ "$port" -ge 1 ] 2>/dev/null || exit 1
[ "$port" -le 65535 ] 2>/dev/null || exit 1

# Published container ports are bound on the guest's loopback and its bridge
# addresses; only loopback is ever a legitimate target here.
case "$host" in
  127.0.0.1 | localhost) ;;
  *) exit 1 ;;
esac

exec socat - "TCP:127.0.0.1:${port}"
