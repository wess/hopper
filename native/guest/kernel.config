# Kernel config fragment for the Hopper guest, merged onto `make defconfig`
# (arm64). Everything Docker + Virtualization.framework needs is built in (=y,
# not =m) because the OS runs entirely from the initramfs with no modules.
# Used by .github/workflows/engine.yml via scripts/kconfig/merge_config.sh.

# initramfs / early userspace
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# virtio transports + devices (block, net, console, balloon, entropy)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_FS=y

# vsock — how dockerd's socket is forwarded to the host bridge
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# filesystems: data disk (ext4), container storage (overlay)
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y

# cgroups v2 + namespaces — required by the container runtime
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# networking: bridge, veth, NAT, conntrack, iptables — Docker's default stack.
# IPv6 must be built-in (=y, not =m): bridge `depends on IPV6 || IPV6=n`, so a
# modular IPv6 silently caps CONFIG_BRIDGE at =m — and an initramfs-only OS has
# no modules, so dockerd then can't create docker0 ("operation not supported").
CONFIG_IPV6=y
CONFIG_LLC=y
CONFIG_STP=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_VXLAN=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# nftables backend (Alpine's iptables uses nft) — dockerd builds its DOCKER
# NAT chain via the nft `nat` table, which needs these. Without them dockerd
# fails: "iptables (nf_tables): TABLE_ADD failed (Not supported): table nat".
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_CONNTRACK_NETLINK=y

# bpf (dockerd device filtering, modern features)
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y

# binfmt_misc — lets the guest register Rosetta as the amd64 interpreter
CONFIG_BINFMT_MISC=y
CONFIG_BINFMT_ELF=y
