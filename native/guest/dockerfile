# Builds the Hopper guest rootfs: a minimal Linux carrying the Apache-2.0
# Docker Engine (dockerd + containerd + runc + docker-init + docker-proxy),
# socat (the vsock forwarder), and the tools `init` needs (mkfs, mount, ip).
# scripts/build/guest.sh exports this rootfs and packs it into an initramfs.
#
# Licensing: everything here is Apache-2.0 / permissive — no Docker Desktop
# bits, no Docker trademarks shipped.
FROM alpine:3.20

# aarch64 for Apple Silicon; amd64 images then run via Rosetta in the VM.
ARG DOCKER_VERSION=27.5.1
ARG DOCKER_ARCH=aarch64

RUN apk add --no-cache \
      busybox \
      e2fsprogs \
      util-linux \
      iproute2 \
      socat \
      ca-certificates \
      iptables \
      openssl \
      cpio

# Static Docker Engine tarball from download.docker.com (Moby, Apache-2.0).
RUN wget -O /tmp/docker.tgz \
      "https://download.docker.com/linux/static/stable/${DOCKER_ARCH}/docker-${DOCKER_VERSION}.tgz" \
 && tar -xzf /tmp/docker.tgz -C /tmp \
 && cp /tmp/docker/* /usr/bin/ \
 && rm -rf /tmp/docker /tmp/docker.tgz

COPY init /init
COPY agent /agent
RUN chmod +x /init /agent
