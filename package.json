    "@basket/ui": "workspace:*",
    "@basket/window": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "butter": "file:./butter",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
