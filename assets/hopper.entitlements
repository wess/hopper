<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hopper no longer runs a VM of its own. On macOS the engine is Apple's
	     `container`, which does its own virtualization in its own privileged
	     helpers, so `com.apple.security.virtualization` is not needed here —
	     and without it an ad-hoc dev build behaves like the signed one. -->

	<!-- Bind-mounted host directories, and the tars an import stages on disk. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Registry pulls, the Docker socket, and published container ports. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
