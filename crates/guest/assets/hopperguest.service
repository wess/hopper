[Unit]
Description=Hopper guest command service
After=local-fs.target
ConditionVirtualization=vm

[Service]
Type=simple
ExecStartPre=/usr/libexec/hopperguest --bootstrap
ExecStart=/usr/libexec/hopperguest
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
TimeoutStartSec=190
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
